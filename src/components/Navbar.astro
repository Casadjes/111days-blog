---
import { SignInButton, SignedIn, SignedOut, UserButton } from "@clerk/astro/components";
---

<nav class="bg-gray-900 text-white">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
      <span class="self-center text-2xl font-semibold whitespace-nowrap"
        >RetoDe<span class="text-indigo-400">111</span>Días</span
      >
    </a>
    <div class="flex items-center h-full w-auto gap-5">
      <ul class="text-base font-medium flex gap-7">
        <li>
          <a href="/" class="block hover:text-indigo-400" aria-current="page">Inicio</a>
        </li>
        <li>
          <a href="/articles" class="block hover:text-indigo-400">Articulos</a>
        </li>
        <li>
          <a href="/about" class="block hover:text-indigo-400">Acerca del reto</a>
        </li>
      </ul>
      <!-----
      sign in / sign out
      --- -->
      <div class="flex items-center">
        <SignedOut>
          <SignInButton mode="modal" asChild>
            <button class="bg-blue-500 px-3 py-1 rounded-lg">Iniciar sesión</button>
          </SignInButton>
        </SignedOut>
        <SignedIn>
          <UserButton />
        </SignedIn>
      </div>
    </div>
  </div>
</nav>
